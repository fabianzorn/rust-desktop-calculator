# ==============================================================================
# Rust Standard Configuration
# ==============================================================================

# Exclude all build artifacts and target directories
/target/

# Backup files and workspace variables generated by Cargo
**/*.rs.bk
*.workspace

# ==============================================================================
# JetBrains RustRover & IntelliJ Configuration
# ==============================================================================

# Exclude the entire RustRover IDE configuration folder
.idea/

# Ignore user-specific, local runtime settings
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionary.xml
.idea/**/shelf/

# Exclude local caches and IDE histories
.idea/caches/
.idea/libraries/
.idea/vcs.xml
.idea/encodings.xml

# CMake caches (in case you bind native C libraries)
cmake-build-debug/
cmake-build-release/

# ==============================================================================
# OS & Environmental Files
# ==============================================================================

# System files for macOS, Windows, and Linux
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp

# Local secrets and environment variables (e.g., database tokens)
.env
.env.local
